# Network
PORT=3000

# Security
# Set to a strong random value in production.
API_TOKEN=change-me
# For local experimentation only. Keep false in shared environments.
DISABLE_AUTH=false

# Queue and execution
CONCURRENCY_LIMIT=2
DEFAULT_TIMEOUT_MS=1800000
MAX_TIMEOUT_MS=7200000
JOB_RETENTION_MS=86400000
WORK_ROOT=.bridge-work

# API and throughput
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Optional command-key extensions
# ALLOWED_COMMAND_KEYS=deploy,release

# Optional explicit command overrides (JSON)
# Note: overrides are still blocked unless executable is one of:
# swift, xcodebuild, xcrun, bundle
# COMMAND_OVERRIDES_JSON={"tests":["bundle","exec","fastlane","test"]}

# Allowed env passthrough from POST /jobs env payload
ALLOWED_ENV_PREFIXES=CI_,APP_,XCODE_,SIM_,FASTLANE_,BUILD_,TEST_
ALLOWED_ENV_KEYS=PATH,HOME,SHELL,LANG,LC_ALL,TERM,DEVELOPER_DIR,SDKROOT,TMPDIR

# Redaction behavior
REDACT_ENV_KEYWORDS=TOKEN,SECRET,PASSWORD,KEY,AUTH,CREDENTIAL

# Optional deterministic simulator defaults
DEFAULT_SIMULATOR_DEVICE=
DEFAULT_SIMULATOR_OS=

# Optional Slack bot-token notification when a job produces one or more .ipa artifacts
# Requires a Bot User OAuth token (xoxb-...) with chat:write scope.
SLACK_BOT_TOKEN=
# Target channel name or ID (e.g. #ios-builds or C0123456789)
SLACK_CHANNEL=
